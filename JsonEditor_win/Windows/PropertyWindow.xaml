<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="JsonEditor_win.Windows.PropertyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JsonEditor_win.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PropertyWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Orientation="Vertical">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name:" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" FontSize="16" Margin="10" 
                         Text="{x:Bind PropertyViewModel.Property.Name, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Text="Value:" FontSize="16" Margin="5,0,0,0" 
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" FontSize="16" Margin="10"
                         Text="{x:Bind PropertyViewModel.Property.Value, Mode=TwoWay}"
                         IsEnabled="{x:Bind PropertyViewModel.Property.IsValueEnabled, Mode=TwoWay}"/>
            </Grid>
            <RadioButtons Margin="10" MaxColumns="3" Header="Type:" FontSize="16"
                          ItemsSource="{x:Bind JsonTypes}" 
                          SelectedItem="{x:Bind PropertyViewModel.Property.Type, Mode=TwoWay}"/>

            <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add" FontSize="16" Margin="0,0,10,0" Visibility="{x:Bind IsAddMode}"
                        Command="{x:Bind JsonViewModel.AddPropertyCommand}"/>
                <Button Content="Delete" FontSize="16" Margin="0,0,10,0" Visibility="{x:Bind IsEditMode}"
                        Command="{x:Bind JsonViewModel.DeletePropertyCommand}"/>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
