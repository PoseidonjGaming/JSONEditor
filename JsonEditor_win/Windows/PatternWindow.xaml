<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="JsonEditor_win.Windows.PatternWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JsonEditor_win.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PatternWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="Patterns:" FontSize="16"/>
            <ListBox FontSize="16" ItemsSource="{x:Bind PatternViewModel.Patterns}"
                     SelectedItem="{x:Bind PatternViewModel.SelectedPattern, Mode=TwoWay}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Pattern Name:" FontSize="16" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" FontSize="16" Margin="0,5,0,0" 
                     Text="{x:Bind PatternViewModel.PatternName, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="10" Orientation="Horizontal">
            <Button Content="Add" FontSize="16" Margin="0,0,10,0"
                    Command="{x:Bind PatternViewModel.AddPatternCommand}"
                    CommandParameter="{x:Bind JsonViewModel.Json, Mode=OneWay}"/>
            <Button Content="Delete" FontSize="16" Margin="0,0,10,0"
                    Command="{x:Bind PatternViewModel.RemovePatternCommand}"/>
            <Button Content="Load" FontSize="16"
                    Command="{x:Bind PatternViewModel.LoadPatternCommand}"
                    CommandParameter="{x:Bind JsonViewModel, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Window>
